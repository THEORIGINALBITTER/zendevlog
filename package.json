{
  "scripts": {
    "build": "npm run validate:cross-links && npm run generate:sitemap && npm run build:orbit && npm run sync:dist",
    "build:orbit": "vite build",
    "sync:dist": "rm -rf dist && mkdir dist && cp index.html manifest.json robots.txt sitemap.xml dist/ && cp -r assets posts php dist/",
    "deploy:pack": "npm run build",
    "watch:orbit": "vite build --watch",
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "validate:cross-links": "node scripts/validate-cross-links.js"
  },
  "dependencies": {
    "@denisbitter/bitter-button-menu": "^1.0.0",
    "framer-motion": "^12.38.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.0"
  }
}
